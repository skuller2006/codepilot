# CodePilot AI — Environment Variables
# Copy this file to .env and fill in your values

# ─── REQUIRED ─────────────────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── OPTIONAL ─────────────────────────────────────────────────────────────
# Default: qwen/qwen3.8-27b
# Other options: openai/gpt-oss-120b, openai/gpt-oss-20b, groq/compound
GROQ_MODEL=qwen/qwen3.8-27b

# Temporary directory for extracted repositories (default: /tmp/codepilot_repos)
# REPO_TEMP_DIR=/tmp/codepilot_repos
